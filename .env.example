# Numi API (protects your server)
NUMI_ENV=production
NUMI_API_KEY=change-me-long-secret
NUMI_MODEL_ID=numi-ot-0.1
NUMI_BACKEND=cloud

# Upstream brain (OpenAI-compatible — NOT Anthropic)
NUMI_CLOUD_API_KEY=
NUMI_CLOUD_BASE_URL=https://api.openai.com/v1
NUMI_CLOUD_MODEL=gpt-4.1

# Optional local toy only:
# NUMI_BACKEND=local
# NUMI_CHECKPOINT=outputs/sft_smoke/final.pt
# NUMI_CONFIG=configs/serving/smoke.yaml
