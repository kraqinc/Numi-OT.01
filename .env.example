# === Tu API key (la generaste en Termux) ===
# Protege Render ← Supabase. NO es de OpenAI ni de xAI.
NUMI_ENV=production
NUMI_API_KEY=pega-aqui-tu-clave-de-termux
NUMI_MODEL_ID=numi-ot-0.1

# Motor: TU modelo (SmolLM2 + LoRA Numi)
NUMI_BACKEND=peft
NUMI_DEVICE=cpu
NUMI_PEFT_BASE=HuggingFaceTB/SmolLM2-1.7B-Instruct
NUMI_PEFT_ADAPTER=/app/adapters/final
NUMI_PEFT_4BIT=0
NUMI_WARMUP=1

# Opcional solo si el adapter/base son privados en HF
# HF_TOKEN=
