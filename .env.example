# Copy to .env and fill real values. Never commit .env

NUMI_ENV=development
NUMI_MODEL_ID=numi-ot-0.1
NUMI_DEVICE=cpu
NUMI_CONFIG=configs/training/sft.yaml
NUMI_CHECKPOINT=

# Required in production/staging (>=16 random chars). Leave empty only for local dev.
NUMI_API_KEY=

# Comma-separated origins; never use * with credentials in production
NUMI_CORS_ORIGINS=http://localhost:3000

NUMI_RATE_LIMIT_RPM=60
NUMI_MAX_CONCURRENT=2
NUMI_HISTORY_TOKENS=1500
NUMI_WARMUP=1
NUMI_MAX_MESSAGES=40
NUMI_MAX_CONTENT_CHARS=8000
NUMI_MAX_OUTPUT_TOKENS=512
